@{
    ViewData["Title"] = "Check your email";
}

<div class="zw-form-card mx-auto">
    <p class="zw-eyebrow mb-1 text-center">Reset your password</p>
    <h1 class="mb-4 text-center">Check your email</h1>

    <div class="zw-card p-4 text-center">
        <p class="zw-muted mb-0">
            If an account exists with that email, a password reset link is on its way. It can
            take a minute or two to arrive.
        </p>
    </div>
    <p class="mt-3 text-center zw-muted">
        <a asp-controller="Account" asp-action="Login">Back to log in</a>
    </p>
</div>
