@model ZapWatch.Web.Models.Account.ProfileViewModel
@{
    ViewData["Title"] = "Account settings";
    ViewData["Robots"] = "noindex, nofollow";
}

<div class="zw-form-card mx-auto">
    <p class="zw-eyebrow mb-1 text-center">Your account</p>
    <h1 class="mb-4 text-center">Account settings</h1>

    <div class="zw-card p-4">
        @if (TempData["ProfileSaved"] != null)
        {
            <div class="alert alert-success">Saved.</div>
        }
        @if (TempData["WelcomeNeedsPhone"] != null)
        {
            <div class="alert alert-warning">Welcome! Add a phone number below so SMS alerts have somewhere to go.</div>
        }
        @if (TempData["EmailConfirmed"] != null)
        {
            <div class="alert alert-success">Email confirmed.</div>
        }
        @if (TempData["ConfirmationResent"] != null)
        {
            <div class="alert alert-success">Verification email resent.</div>
        }
        @if (TempData["ExternalLoginError"] is string confirmError)
        {
            <div class="alert alert-warning">@confirmError</div>
        }

        <form asp-action="Profile" method="post">
            @* ModelOnly, not All - this page has two independent forms (this one and
               _ChangePasswordForm below) sharing one ModelState; "All" leaked the other form's
               field errors into this summary on any failed submission of either form. Each field
               below already shows its own error inline via asp-validation-for. *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-group mb-3">
                <label class="form-label">Email</label>
                <input value="@Model.Email" class="form-control" disabled />
                @{
                    var linkedProviders = ViewBag.LinkedProviders as List<string> ?? new List<string>();
                }
                @if (linkedProviders.Count > 0)
                {
                    <div class="form-text">Signed in with @string.Join(" and ", linkedProviders).</div>
                }
            </div>
            <div class="form-group mb-4">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="+1XXXXXXXXXX" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Save</button>
        </form>
    </div>
</div>

@{
    var pwModel = ViewBag.ChangePasswordModel as ZapWatch.Web.Models.Account.ChangePasswordViewModel
        ?? new ZapWatch.Web.Models.Account.ChangePasswordViewModel();
}
@await Html.PartialAsync("_ChangePasswordForm", pwModel)

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
