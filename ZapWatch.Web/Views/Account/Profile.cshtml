@model ZapWatch.Web.Models.Account.ProfileViewModel
@{
    ViewData["Title"] = "Account settings";
}

<h1>Account settings</h1>

@if (TempData["ProfileSaved"] != null)
{
    <div class="alert alert-success">Saved.</div>
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Profile" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group mb-3">
                <label class="form-label">Email</label>
                <input value="@Model.Email" class="form-control" disabled />
            </div>
            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="+1XXXXXXXXXX" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
