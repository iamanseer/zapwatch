@model ZapWatch.Web.Models.Account.ProfileViewModel
@{
    ViewData["Title"] = "Account settings";
}

<div class="zw-form-card mx-auto">
    <p class="zw-eyebrow mb-1 text-center">Your account</p>
    <h1 class="mb-4 text-center">Account settings</h1>

    <div class="zw-card p-4">
        @if (TempData["ProfileSaved"] != null)
        {
            <div class="alert alert-success">Saved.</div>
        }

        <form asp-action="Profile" method="post">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <div class="form-group mb-3">
                <label class="form-label">Email</label>
                <input value="@Model.Email" class="form-control" disabled />
            </div>
            <div class="form-group mb-4">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" placeholder="+1XXXXXXXXXX" autocomplete="tel" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Save</button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
