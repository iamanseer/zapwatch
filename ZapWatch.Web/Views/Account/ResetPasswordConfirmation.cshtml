@{
    ViewData["Title"] = "Password reset";
}

<div class="zw-form-card mx-auto">
    <p class="zw-eyebrow mb-1 text-center">Reset your password</p>
    <h1 class="mb-4 text-center">Password updated</h1>

    <div class="zw-card p-4 text-center">
        <p class="zw-muted mb-3">Your password has been reset. Log in with your new password.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Log in</a>
    </div>
</div>
