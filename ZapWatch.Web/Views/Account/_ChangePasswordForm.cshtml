@model ZapWatch.Web.Models.Account.ChangePasswordViewModel
@{
    var hasPassword = ViewBag.HasPassword == true;
    var linkedProviders = ViewBag.LinkedProviders as List<string> ?? new List<string>();
    var linkedProvidersText = linkedProviders.Count > 0 ? string.Join(" or ", linkedProviders) : "your linked account";
}

<div class="zw-form-card mx-auto mt-4">
    <div class="zw-card p-4">
        <p class="zw-eyebrow mb-3">@(hasPassword ? "Change password" : "Set a password")</p>

        @if (TempData["PasswordChanged"] as string == "changed")
        {
            <div class="alert alert-success">Password changed.</div>
        }
        @if (TempData["PasswordChanged"] as string == "set")
        {
            <div class="alert alert-success">Password set — you can now log in with your email and this password, or keep using @linkedProvidersText.</div>
        }
        @if (!hasPassword)
        {
            <p class="zw-muted mb-3" style="font-size:0.88rem;">
                You signed in with @linkedProvidersText and don't have a password yet. Set one below
                to also be able to log in directly with your email.
            </p>
        }

        <form asp-action="ChangePassword" method="post">
            @* ModelOnly, not All - see the matching comment in Profile.cshtml; this partial
               shares a page (and ModelState) with the profile-update form above it. *@
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            @if (hasPassword)
            {
                <div class="form-group mb-3">
                    <label asp-for="CurrentPassword" class="form-label"></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                    <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                </div>
            }
            <div class="form-group mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="form-group mb-4">
                <label asp-for="ConfirmPassword" class="form-label"></label>
                <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">@(hasPassword ? "Change password" : "Set password")</button>
        </form>
    </div>
</div>
