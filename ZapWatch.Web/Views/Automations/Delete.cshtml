@model ZapWatch.Web.Models.Automation
@{
    ViewData["Title"] = "Delete automation";
}

<p class="zw-eyebrow mb-1">Remove watch</p>
<h1 class="mb-4">Delete automation</h1>

<div class="zw-card zw-form-card p-4">
    <p class="zw-muted">
        Are you sure you want to delete <strong class="text-body">@Model.Name</strong>? This also
        deletes its ping history and alert history — this can't be undone.
    </p>
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
