@model IEnumerable<ZapWatch.Web.Models.Automation>
@{
    ViewData["Title"] = "Automations";
}

@{
    var limit = (int)ViewData["AutomationLimit"]!;
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <div>
        <p class="zw-eyebrow mb-1">Watch list</p>
        <h1 class="mb-0">Automations</h1>
        <p class="zw-muted mb-0" style="font-size:0.85rem;">@Model.Count() of @limit automations used</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add automation</a>
</div>

@if (!Model.Any())
{
    <div class="zw-empty">
        <h3 class="mb-0">Nothing on watch yet</h3>
        <p>Add an automation to get a ping URL, then point a Webhooks by Zapier step at it to start monitoring.</p>
        <a asp-action="Create" class="btn btn-primary">Add your first automation</a>
    </div>
}
else
{
    <div class="zw-table-wrap">
        <div class="table-responsive">
            <table class="table zw-table align-middle">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Name</th>
                        <th>Expected every</th>
                        <th>Grace</th>
                        <th>Last seen</th>
                        <th>Last alert</th>
                        <th>Ping URL</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var pingUrl = $"{Context.Request.Scheme}://{Context.Request.Host}/ping/{item.PingToken}";
                        string statusClass;
                        string statusLabel;
                        if (item.Status == ZapWatch.Web.Models.AutomationStatus.Paused)
                        {
                            statusClass = "zw-status--paused";
                            statusLabel = "Paused";
                        }
                        else if (item.Status == ZapWatch.Web.Models.AutomationStatus.Overdue)
                        {
                            statusClass = "zw-status--overdue";
                            statusLabel = "Overdue";
                        }
                        else if (item.LastSeenAt is null)
                        {
                            statusClass = "zw-status--waiting";
                            statusLabel = "Awaiting first ping";
                        }
                        else
                        {
                            statusClass = "zw-status--ok";
                            statusLabel = "Live";
                        }
                        <tr data-automation-id="@item.Id">
                            <td>
                                <span class="zw-status @statusClass" data-role="status">
                                    <span class="zw-status-dot"></span><span data-role="status-label">@statusLabel</span>
                                </span>
                            </td>
                            <td class="fw-semibold">@item.Name</td>
                            <td class="zw-muted">@item.ExpectedFrequencyMinutes min</td>
                            <td class="zw-muted">@item.GracePeriodMinutes min</td>
                            <td class="zw-muted" data-role="last-seen">@(item.LastSeenAt?.ToString("yyyy-MM-dd HH:mm") ?? "Never")</td>
                            <td>
                                @{
                                    var lastAlert = item.AlertEvents.FirstOrDefault();
                                }
                                @if (lastAlert is null)
                                {
                                    <span class="zw-muted">&mdash;</span>
                                }
                                else if (string.IsNullOrEmpty(lastAlert.Channel))
                                {
                                    <span class="zw-alert-fail">Send failed</span>
                                }
                                else
                                {
                                    <span style="color: var(--zw-ok);">Sent: @lastAlert.Channel</span>
                                }
                                @if (!string.IsNullOrEmpty(lastAlert?.FailureDetails))
                                {
                                    <br /><span class="zw-alert-fail small">@lastAlert.FailureDetails</span>
                                }
                            </td>
                            <td>
                                <span class="zw-ping-url" data-ping-url="@pingUrl">
                                    <code>@pingUrl</code>
                                    <button type="button" class="zw-copy-btn" data-copy-target aria-label="Copy ping URL">Copy</button>
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/automations.js" asp-append-version="true"></script>
}
