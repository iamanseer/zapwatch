@{
    ViewData["Title"] = "Smoke Test - Day-0 Hangfire & SignalR Verification";
    ViewData["Robots"] = "noindex, nofollow";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1>ZapWatch Day-0 Smoke Test</h1>
            <p class="text-muted">
                <strong>Page loaded at:</strong> <span id="pageLoadTime">@DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm:ss.fff")</span> UTC
            </p>

            <div class="alert alert-info" role="alert">
                <strong>Instructions:</strong> Leave this tab open for 30–60 minutes without refreshing.
                Check the logs below for continuous updates (roughly once per minute from Hangfire,
                plus connection status changes from SignalR).
            </div>

            <div class="card">
                <div class="card-header">
                    <h5>Live Event Log</h5>
                    <small class="text-muted">
                        Connection Status: <span id="connectionStatus" class="badge bg-danger">Disconnected</span>
                    </small>
                </div>
                <div class="card-body">
                    <div id="eventLog" style="height: 400px; overflow-y: auto; border: 1px solid #ddd; padding: 10px; background-color: #f8f9fa; font-family: monospace; font-size: 12px;">
                        <div class="text-muted">Waiting for events...</div>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <p class="text-muted">
                    <small>
                        <strong>Hangfire Dashboard:</strong> Check <a href="/hangfire" target="_blank">/hangfire</a>
                        to confirm the "smoke-test-tick" recurring job succeeds every minute.
                    </small>
                </p>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>

<script>
    const connection = new signalR.HubConnectionBuilder()
        .withUrl("/hubs/automation-status")
        .withAutomaticReconnect()
        .build();

    const eventLog = document.getElementById('eventLog');
    const connectionStatus = document.getElementById('connectionStatus');

    function addLogEntry(message) {
        const timestamp = new Date().toLocaleTimeString('en-US', {
            hour12: false,
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            fractionalSecondDigits: 3
        });
        const entry = document.createElement('div');
        entry.textContent = `[${timestamp}] ${message}`;

        // Clear placeholder on first entry
        if (eventLog.children.length === 1 && eventLog.querySelector('.text-muted')) {
            eventLog.innerHTML = '';
        }

        eventLog.appendChild(entry);
        eventLog.scrollTop = eventLog.scrollHeight;
    }

    connection.on("SmokeTestTick", (timestamp) => {
        addLogEntry(`📍 Hangfire Tick: ${timestamp}`);
    });

    connection.onreconnecting((error) => {
        console.log(`Attempting to reconnect. Error: ${error}`);
        connectionStatus.textContent = 'Reconnecting';
        connectionStatus.className = 'badge bg-warning';
        addLogEntry('⚠️ SignalR: Reconnecting...');
    });

    connection.onreconnected((connectionId) => {
        console.log(`Reconnected with connection ID ${connectionId}.`);
        connectionStatus.textContent = 'Connected';
        connectionStatus.className = 'badge bg-success';
        addLogEntry('✅ SignalR: Reconnected');
    });

    connection.onclose(async () => {
        console.log('Connection closed.');
        connectionStatus.textContent = 'Disconnected';
        connectionStatus.className = 'badge bg-danger';
        addLogEntry('❌ SignalR: Disconnected');
    });

    connection.start()
        .then(() => {
            console.log('SignalR connected.');
            connectionStatus.textContent = 'Connected';
            connectionStatus.className = 'badge bg-success';
            addLogEntry('✅ SignalR: Connected');
        })
        .catch(err => {
            console.error('Error connecting to SignalR:', err);
            connectionStatus.textContent = 'Error';
            connectionStatus.className = 'badge bg-danger';
            addLogEntry(`❌ SignalR Error: ${err.message}`);
        });
</script>
