@model IReadOnlyList<ZapWatch.Web.Services.PlanDefinition>
@{
    var isAuthed = User.Identity?.IsAuthenticated == true;
}

<section id="pricing" class="py-5 border-top">
    <p class="zw-eyebrow mb-1">Pricing</p>
    <h2 class="mb-4">Priced by how many clients you're watching.</h2>
    <div class="row g-3">
        @foreach (var plan in Model)
        {
            <div class="col-md-4">
                <div class="zw-card p-4 h-100 d-flex flex-column">
                    <p class="zw-eyebrow mb-1">@plan.Name</p>
                    <p class="mb-1"><span style="font-size:1.8rem;font-weight:800;">&#8377;@plan.PriceInRupees</span> <span class="zw-muted">/month</span></p>
                    <p class="zw-muted mb-4">Up to @plan.AutomationLimit monitored automations</p>
                    @if (isAuthed)
                    {
                        <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-secondary mt-auto">Subscribe</a>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-secondary mt-auto">Start free</a>
                    }
                </div>
            </div>
        }
    </div>
</section>
