<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZapWatch</title>
    <meta name="theme-color" content="#ffffff" />
    <script>
        // Set before first paint so there's no flash of the wrong theme.
        // Light is the default for first-time visitors; a saved choice always wins after that.
        (function () {
            var saved = localStorage.getItem("zw-theme") || "light";
            document.documentElement.setAttribute("data-theme", saved);
            document.documentElement.setAttribute("data-bs-theme", saved);
        })();
    </script>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ZapWatch.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="zw-header">
        <nav class="navbar navbar-expand-sm">
            <div class="container">
                <a class="zw-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="zw-dot" aria-hidden="true"></span>
                    Zap<span class="zw-brand-watch">Watch</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link zw-nav-link" asp-area="" asp-controller="Automations" asp-action="Index">Automations</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link zw-nav-link" asp-area="" asp-controller="Subscription" asp-action="Index">Billing</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link zw-nav-link" asp-area="" asp-controller="Home" asp-action="HowItWorks">How it works</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link zw-nav-link" asp-area="" asp-controller="Home" asp-action="Pricing">Pricing</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        <li class="nav-item">
                            <button type="button" class="nav-link zw-nav-link zw-theme-toggle" id="zwThemeToggle" aria-label="Switch theme">
                                <svg class="zw-icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <circle cx="12" cy="12" r="4"></circle>
                                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
                                </svg>
                                <svg class="zw-icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                                </svg>
                            </button>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link zw-nav-link zw-nav-user" asp-controller="Account" asp-action="Profile">@User.Identity!.Name</a>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="nav-link zw-nav-link btn btn-link">Log out</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link zw-nav-link" asp-controller="Account" asp-action="Login">Log in</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-sm-2" asp-controller="Account" asp-action="Register">Sign up</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container zw-page">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="zw-footer">
        <div class="container d-flex justify-content-between">
            <span>&copy; 2026 ZapWatch</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
