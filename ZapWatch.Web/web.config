<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        Temporary diagnostic: stdoutLogEnabled=true so that if the app crashes at startup again
        (as it did with the first Microsoft/GitHub sign-in deploy - see MODULES.md/incident memory),
        the actual exception lands in .\logs\stdout_*.log instead of IIS just returning a bare 500
        with no detail. Turn this back off once a couple of days have passed without incident -
        the SDK will still overwrite processPath/arguments/hostingModel with the correct values at
        publish time either way.
      -->
      <aspNetCore processPath="dotnet" arguments=".\ZapWatch.Web.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
