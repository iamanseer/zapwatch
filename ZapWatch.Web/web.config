<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!--
        stdoutLogEnabled=true so a startup/request-pipeline crash lands in .\logs\stdout_*.log
        instead of IIS just returning a bare 500 with no detail - this exact gap cost two rounds
        of blind revert-and-guess during the 2026-08-03 empty-ClientId incident (see MODULES.md
        Module 3 follow-up slice 1). Kept on permanently rather than as a temporary measure -
        this is a low-traffic solo-operator app, log volume isn't a real concern, and the one time
        it mattered it was the only way to actually find the bug.
      -->
      <aspNetCore processPath="dotnet" arguments=".\ZapWatch.Web.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
